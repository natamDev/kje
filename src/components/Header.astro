---
import { club } from '../data/club';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/dojo', label: 'Le dojo' },
  { href: '/planning', label: 'Planning' },
  { href: '/actualites', label: 'Actualités' },
  { href: '/tarifs', label: 'Tarifs' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header>
  <div class="header-inner">
    <a class="brand" href="/">
      <img src="/logo-rond.png" alt={`Logo ${club.nom}`} width="52" height="52" />
      <span>{club.nom}</span>
    </a>
    <nav>
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
