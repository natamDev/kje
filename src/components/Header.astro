---
import { club } from '../data/club';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/dojo', label: 'Le dojo' },
  { href: '/planning', label: 'Planning' },
  { href: '/actualites', label: 'Actualités' },
  { href: '/tarifs', label: 'Tarifs' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header>
  <div class="header-inner">
    <a class="brand" href="/">
      <img src="/logo-128.png" alt={`Logo ${club.nom}`} width="52" height="52" />
      <span>{club.nom}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" hidden>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="menu-icone-ouvrir" d="M3 5h14M3 10h14M3 15h14" />
        <path class="menu-icone-fermer" d="M5 5l10 10M15 5L5 15" />
      </svg>
      <span>Menu</span>
    </button>
    <nav id="menu-principal" aria-label="Menu principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Sans JavaScript, le bouton reste caché et le menu s'affiche en entier.
  const bouton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  if (bouton) {
    const fermer = () => bouton.setAttribute('aria-expanded', 'false');
    bouton.hidden = false;
    bouton.addEventListener('click', () => {
      const ouvert = bouton.getAttribute('aria-expanded') === 'true';
      bouton.setAttribute('aria-expanded', String(!ouvert));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
        fermer();
        bouton.focus();
      }
    });
  }
</script>
