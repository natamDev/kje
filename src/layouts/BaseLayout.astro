---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { club } from '../data/club';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Dojo Kyokushin et Jujutsu Eskrima : cours d’arts martiaux pour enfants et adultes, planning, actualités et résultats du club.',
} = Astro.props;

const pageTitle = `${title} — Dojo Kyokushin + Jujutsu Eskrima`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/logo.jpg', Astro.site);
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" />
    <link rel="icon" type="image/png" href="/symbole_rouge_centre.png" />
    <link rel="apple-touch-icon" href="/symbole_rouge_centre.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: club.nom,
      legalName: club.nomLegal,
      description,
      image: ogImageURL,
      foundingDate: club.dateCreation,
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'SIREN',
        value: club.siren.replace(/ /g, ''),
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: club.lieuCours.rue,
        postalCode: club.lieuCours.codePostal,
        addressLocality: club.lieuCours.ville,
        addressCountry: club.lieuCours.pays,
      },
      telephone: club.telephoneInternational,
      email: club.email,
    })} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
