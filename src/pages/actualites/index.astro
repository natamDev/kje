---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const actus = (await getCollection('actualites'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Actualités du club"
  description="Les actualités du club de karaté Kyokushin Jutsu Eskrima d’Aubagne : passages de grade, remises de ceintures, stages, forums et vie du dojo."
>
  <h1>Actualités</h1>
  <ul class="cartes">
    {actus.map((actu) => (
      <li>
        <a href={url(`/actualites/${actu.slug}`)}>
          {actu.data.coverImage && (
            <img class="carte-image" src={url(actu.data.coverImage)} alt="" loading="lazy" />
          )}
          <span class="discret">{actu.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          <span class="carte-titre">{actu.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
