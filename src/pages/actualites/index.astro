---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const actus = (await getCollection('actualites'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Actualités"
  description="Toutes les actualités du dojo : stages, événements et vie du club."
>
  <h1>Actualités</h1>
  <ul class="cartes">
    {actus.map((actu) => (
      <li>
        <a href={`/actualites/${actu.slug}`}>
          {actu.data.coverImage && (
            <img class="carte-image" src={actu.data.coverImage} alt="" loading="lazy" />
          )}
          <span class="discret">{actu.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          <span class="carte-titre">{actu.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
