---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const actus = await getCollection('actualites');
  return actus.map((actu) => ({
    params: { slug: actu.slug },
    props: { actu },
  }));
}

const { actu } = Astro.props;
const { Content } = await render(actu);
const { title, date, medias = [], video } = actu.data;
---
<BaseLayout
  title={title}
  description={`Actualité du club de karaté d’Aubagne : ${title}.`}
  article={{ publication: date, image: actu.data.coverImage ?? medias[0] }}
>
  <article class="actu">
    <p class="discret">{date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    <h1>{title}</h1>
    <Content />

    {video && (
      <video class="actu-video" controls preload="metadata" poster={medias[0] && url(medias[0])}>
        <source src={url(video)} type="video/mp4" />
      </video>
    )}

    {medias.length > 0 && (
      <div class="medias">
        {medias.map((src, i) => (
          <a href={url(src)}>
            <img src={url(src)} alt={`${title} — photo ${i + 1}`} loading="lazy" />
          </a>
        ))}
      </div>
    )}

    <p><a class="lien-souligne" href={url('/actualites')}>Toutes les actualités</a></p>
  </article>
</BaseLayout>
