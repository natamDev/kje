---
import BaseLayout from '../layouts/BaseLayout.astro';
import { saison, coursEssai, cotisations, fraisAnnuels, equipement, libellePeriode, formatPrix } from '../data/tarifs';
---
<BaseLayout
  title="Tarifs"
  description="Tarifs et cotisations du dojo pour les cours de Kyokushin et Jutsu Eskrima."
>
  <h1>Tarifs saison {saison}</h1>

  <p class="accroche">
    {coursEssai.label} : <strong>{formatPrix(coursEssai.prixCentimes)}</strong>.
    <a href="/contact">Contactez-nous</a> pour venir essayer un cours.
  </p>

  <section>
    <h2>Cotisations</h2>
    <p class="discret">Calculées pour deux cours par semaine, de septembre à juin.</p>
    <table>
      <thead>
        <tr><th>Âge</th><th>Prix</th><th>Période</th></tr>
      </thead>
      <tbody>
        {cotisations.map((t) => (
          <tr>
            <td>{t.label}</td>
            <td>{formatPrix(t.prixCentimes)}</td>
            <td>{libellePeriode[t.periode]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section>
    <h2>Frais annuels</h2>
    <table>
      <tbody>
        {fraisAnnuels.map((t) => (
          <tr>
            <td>{t.label}</td>
            <td>{formatPrix(t.prixCentimes)}</td>
            <td>{libellePeriode[t.periode]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note-licence">
      La licence est délivrée par la Fédération Française de Karaté.
      Retrouvez-la dans votre
      <a href="https://www.ffkarate.fr/espace-licencies/" target="_blank" rel="noopener">espace licencié FFK<span class="visually-hidden"> (nouvel onglet)</span> ↗</a>.
    </p>
  </section>

  <section>
    <h2>Équipement</h2>
    <table>
      <tbody>
        {equipement.map((e) => (
          <tr>
            <td>{e.label}{e.note && <span class="discret"> ({e.note})</span>}</td>
            <td>{e.prixCentimes !== undefined ? formatPrix(e.prixCentimes) : 'Obligatoire'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="conditions">
    <p class="encadre">Certificat médical obligatoire</p>
    <p>
      Possibilité de payer en 2 fois maximum : tous les chèques sont remis à
      l'inscription, en indiquant les dates d'encaissement souhaitées.
    </p>
  </section>
</BaseLayout>
