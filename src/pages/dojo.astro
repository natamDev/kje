---
import BaseLayout from '../layouts/BaseLayout.astro';

const DIF = 'Diplômé d’Instructeur Fédéral (DIF)';

// dan: null tant que le grade n'est pas connu.
const instructeurs: { nom: string; dan: number | null; titre: string }[] = [
  { nom: 'Gérard Calenge', dan: 5, titre: DIF },
  { nom: 'Pascal Wehrle', dan: 4, titre: DIF },
  { nom: 'Ellen Mogica', dan: 1, titre: 'DIF' },
  { nom: 'Laurent [NOM]', dan: 2, titre: 'Assistant' },
  { nom: 'Grégory Cenci', dan: 1, titre: 'Assistant' },

];
---
<BaseLayout
  title="Le dojo"
  description="Le Kyokushin Jutsu Eskrima, son fondateur Alain Setrouk, nos styles et nos instructeurs."
>
  <h1>Le dojo</h1>

  <section>
    <h2>Notre histoire</h2>
    <p>
      Le Kyokushin Jutsu Eskrima est un art martial inspiré du
      Karaté Kyokushinkai et du Kali, art martial philippin basé sur le
      travail d’armes contondantes, tranchantes et à mains nues.
    </p>
    <p>
      Son fondateur, Alain Setrouk, 9<sup>e</sup> Dan,
      Champion du monde de Karaté en 1972, est le pionnier du
      Kyokushinkai en France.
    </p>
  </section>

  <section class="nos-styles">
    <img
      src="/kanji-symbole.jpg"
      alt="Symbole Kyokushin et kanji Osu"
      class="styles-emblem"
      width="415"
      height="1518"
      loading="lazy"
    />
    <div>
      <h2>Nos styles</h2>
      <p>
        Le Kyokushin est un style de karaté full-contact fondé par Mas Oyama,
        reconnu pour la rigueur de son entraînement.
      </p>
      <p>
        Le Jutsu Eskrima combine les techniques de close-combat du Jutsu
        japonais avec l'art martial philippin de l'Eskrima (bâton, lame,
        défense rapprochée).
      </p>
    </div>
  </section>

  <section>
    <h2>Nos instructeurs</h2>
    <ul class="lignes instructeurs">
      {instructeurs.map((i) => (
        <li>
          <strong>{i.nom}</strong>
          {i.dan === null
            ? <span>[X]<sup>e</sup> Dan</span>
            : <span>{i.dan}<sup>{i.dan === 1 ? 'er' : 'e'}</sup> Dan</span>}
          <span class="discret">{i.titre}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
