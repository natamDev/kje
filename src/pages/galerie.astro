---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entrees = (await getCollection('galerie'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Galerie"
  description="Photos et vidéos des événements et entraînements du dojo."
>
  <h1>Galerie</h1>
  {entrees.map((entree) => (
    <section>
      <h2>{entree.data.title}</h2>
      <div class="medias">
        {entree.data.medias.map((src) => (
          <img src={src} alt={entree.data.title} loading="lazy" />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
