---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { creneaux, groupByJour } from '../data/planning';
import { club } from '../data/club';

const dernieresActus = (await getCollection('actualites'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const planningParJour = groupByJour(creneaux);
---
<BaseLayout
  title="Accueil"
  description="Dojo Kyokushin et Jutsu Eskrima : essai gratuit, planning des cours, tarifs et actualités du club."
>
  <section class="hero">
    <div class="hero-kanji" lang="ja">極真空手</div>
    <div class="hero-text">
      <p class="surtitre">Dojo d'arts martiaux · Aubagne · depuis {club.anneeCreation}</p>
      <h1>Forge le corps. Trempe l'esprit.</h1>
      <p class="accroche">
        Karaté Kyokushin et Jutsu Eskrima, enseignés dans le respect de la
        tradition, pour adultes et enfants.
      </p>
      <div class="hero-actions">
        <a class="cta" href={url('/contact')}>Essai gratuit</a>
        <a class="lien-souligne" href={url('/dojo')}>Découvrir le dojo</a>
      </div>
    </div>
    <div class="hero-visuel">
      <img
        src={url('/ours-encre.png')}
        alt="Ours dressé devant une montagne, emblème du dojo"
        class="hero-image"
        width="664"
        height="554"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="bloc horaires-resume">
    <div class="bloc-titre">
      <p class="numero">01 — <span lang="ja">稽古</span></p>
      <h2>Horaires</h2>
      <a class="lien-souligne" href={url('/planning')}>Planning complet</a>
    </div>
    <ul class="lignes">
      {Object.entries(planningParJour).flatMap(([jour, creneauxDuJour]) =>
        creneauxDuJour.map((c) => (
          <li>
            <strong>{jour}</strong>
            <span>{c.heureDebut} – {c.heureFin}</span>
            <span class="discret">{c.cours} · {c.niveau}</span>
          </li>
        ))
      )}
    </ul>
  </section>

  <section class="styles-encre">
    <div>
      <p class="numero">02 — <span lang="ja">極真</span></p>
      <h2>Kyokushin</h2>
      <p>
        Karaté full-contact fondé par Mas Oyama, reconnu pour la rigueur de
        son entraînement.
      </p>
    </div>
    <div>
      <p class="numero">03 — <span lang="ja">柔術</span></p>
      <h2>Jutsu Eskrima</h2>
      <p>
        Le close-combat du Jutsu japonais allié à l'art martial philippin
        de l'Eskrima : bâton, lame, défense rapprochée.
      </p>
    </div>
  </section>

  <section class="bloc video">
    <div class="bloc-titre">
      <p class="numero">04 — <span lang="ja">道場</span></p>
      <h2>Le dojo en vidéo</h2>
      <p class="discret">Reportage de Webbus Pays d'Aubagne.</p>
    </div>
    <div class="video-cadre">
      <iframe
        src="https://www.youtube-nocookie.com/embed/JPf8OOb2EKw"
        title="Asso Kyokushin Jutsu Eskrima Aubagne"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section class="bloc dernieres-actus">
    <div class="bloc-titre">
      <p class="numero">05 — <span lang="ja">便り</span></p>
      <h2>Actualités</h2>
      <a class="lien-souligne" href={url('/actualites')}>Toutes les actualités</a>
    </div>
    <ul class="cartes">
      {dernieresActus.map((actu) => (
        <li>
          <a href={url(`/actualites/${actu.slug}`)}>
            {actu.data.coverImage && (
              <img class="carte-image" src={url(actu.data.coverImage)} alt="" loading="lazy" />
            )}
            <span class="discret">{actu.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            <span class="carte-titre">{actu.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
